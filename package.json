{
  "name": "whimsy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Always-on flight deal scanner across every route. Cheap flights to wherever.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PUBLIC_URL=${PUBLIC_URL:-http://localhost:5173} tsx watch --env-file-if-exists=.env --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist-server/server/index.js",
    "scan:once": "tsx --env-file-if-exists=.env server/cli.ts scan",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "nodemailer": "^10.0.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "d3-geo": "^3.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "world-atlas": "^2.0.2"
  }
}
