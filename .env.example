# ── Server ─────────────────────────────────────────────
PORT=8787
# Public origin used in emails/notifications (links to deals + manage pages).
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/whimsy.db

# ── Scanner ────────────────────────────────────────────
# SCANNER=off runs the site without scanning.
SCANNER=on
# Fare checks per minute across all workers. Keep this polite.
SCAN_RPM=24
SCAN_CONCURRENCY=2
# Restrict origins (comma-separated IATA). Default: every hub in server/airports.ts
# ORIGINS=DTW,ORD,JFK

# ── Email (optional) ───────────────────────────────────
# Any SMTP URL works (Resend, Postmark, SES, Gmail app password…).
# Without it, emails land in the dev outbox at /api/dev/outbox.
# SMTP_URL=smtps://user:pass@smtp.resend.com:465
EMAIL_FROM="Whimsy <deals@example.com>"

# ── Web push (optional) ────────────────────────────────
# Auto-generated and stored in the DB if unset. Set these to keep keys stable across DBs.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deals@example.com

# ── ntfy (optional) ────────────────────────────────────
NTFY_SERVER=https://ntfy.sh
